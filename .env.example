# APP_ENV - Runtime environment name (development or production).
APP_ENV=
# CORS_ORIGINS - Comma-separated explicit frontend origins allowed by the API.
CORS_ORIGINS=
# ORHEX_SESSION_SECRET - Secret used to sign isolated demo session cookies.
ORHEX_SESSION_SECRET=
# MEMWAL_SERVER_URL - Walrus Memory Mainnet relayer endpoint.
MEMWAL_SERVER_URL=
# MEMWAL_ACCOUNT_ID - Walrus account identifier for the server-side delegate.
MEMWAL_ACCOUNT_ID=
# MEMWAL_PRIVATE_KEY - Server-only Walrus delegate private key.
MEMWAL_PRIVATE_KEY=
# MEMWAL_NAMESPACE - Base namespace for user-isolated memories.
MEMWAL_NAMESPACE=
# TATUM_API_KEY - Server-only Tatum API credential.
TATUM_API_KEY=
# TATUM_SUI_RPC_URL - Tatum Sui GraphQL endpoint.
TATUM_SUI_RPC_URL=
# SUI_NETWORK - Sui network name used to verify provider chain identity.
SUI_NETWORK=
